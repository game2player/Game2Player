+		var current_run_gold: = maxi(0, int(State.get("gold")) - expedition.run_summary.starting_gold)
+		_builder_best_run_gold = maxi(_builder_best_run_gold, current_run_gold)
+
+
+func _builder_publish_game_state() -> void :
+	var expedition: ExpeditionScene = curr_scn as ExpeditionScene
+	var in_goblin_expedition: = expedition != null and str(expedition.active_run_selection.get("dungeon_id", "")) == "goblins_dungeon"
+	var current_room: = expedition.room_index + 1 if in_goblin_expedition else 0
+	var current_run_gold: = 0
+	var run_goblin_kills: = 0
+	if in_goblin_expedition:
+		_builder_capture_current_run()
+		if expedition.run_summary != null:
+			current_run_gold = maxi(0, int(State.get("gold")) - expedition.run_summary.starting_gold)
+			var room_kills: Dictionary = expedition.run_summary._current_room.get("kills_by_type", {})
+			if current_room == 2:
+				run_goblin_kills = int(room_kills.get("goblin", 0))
+			for room_record: Dictionary in expedition.run_summary.room_telemetry:
+				if int(room_record.get("room", 0)) == 2:
+					run_goblin_kills = int(room_record.get("kills_by_type", {}).get("goblin", run_goblin_kills))
+	var game_state: = {
+		"task_id": _builder_task_id, 
+		"task_start_ready": _builder_start_ready, 
+		"task_start_matches": _builder_task_start_matches, 
+		"dungeon_id": str(expedition.active_run_selection.get("dungeon_id", "")) if in_goblin_expedition else "", 
+		"room": current_room, 
+		"best_room": _builder_best_room, 
+		"run_goblin_kills": run_goblin_kills, 
+		"gold": int(State.get("gold")), 
+		"run_gold": current_run_gold, 
+		"best_run_gold": _builder_best_run_gold, 
+		"upgrades": {"start_stamina": int(ExpeditionSkillStore.get_level("start_stamina"))}, 
+	}
+	var state: = {
+		"schemaVersion": "1.0.0", 
+		"gameId": "410_my-own-hero-party", 
+		"timestampMs": Time.get_ticks_msec(), 
+		"gameTimeMs": _builder_game_time_ms, 
+		"status": "playing" if _builder_start_ready else "loading", 
+		"is_actionable": _builder_start_ready, 
+		"terminal": {"isTerminal": false, "outcome": null}, 
+		"game_state": game_state, 
+		"metrics": {
+			"run_goblin_kills": run_goblin_kills, 

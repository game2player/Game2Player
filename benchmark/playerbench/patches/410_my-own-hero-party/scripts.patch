+func _builder_policy_scene_phase() -> Variant:
+	var dialogue: DialogueManager = Refs.dialogue as DialogueManager
+	if dialogue != null and is_instance_valid(dialogue) and dialogue.is_active() and dialogue.is_visible_in_tree():
+		return "dialogue"
+	if _builder_get_summary_popup() != null:
+		return "run_summary"
+	if is_switching_scene:
+		return "transition"
+	if curr_scn == null or not is_instance_valid(curr_scn):
+		return null
+	if curr_scn is ExpeditionScene:
+		return "transition" if (curr_scn as ExpeditionScene).is_transitioning else "expedition"
+	if curr_scn is TavernScene:
+		return "tavern"
+	if curr_scn.scene_file_path == MAIN_MENU_PATH:
+		return "main_menu"
+	return "other"
+
+
+func _builder_get_summary_popup() -> ExpeditionVictoryPopup:
+	var popup_manager: PopupManager = Refs.popups as PopupManager
+	if popup_manager == null or not is_instance_valid(popup_manager) or popup_manager.stack.is_empty():
+		return null
+	var popup: Control = popup_manager.stack.back()
+	if popup is ExpeditionVictoryPopup and popup.is_visible_in_tree():
+		return popup as ExpeditionVictoryPopup
+	return null
+

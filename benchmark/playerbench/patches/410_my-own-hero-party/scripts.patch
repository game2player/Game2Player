+func _builder_publish_policy_observation() -> void :
+	var scene_phase: Variant = _builder_policy_scene_phase()
+	var visible_gold_pickups: Variant = null
+	var visible_action_targets: Variant = null
+	if scene_phase != null:
+		visible_gold_pickups = []
+		visible_action_targets = []
+		if scene_phase == "expedition" and curr_scn is ExpeditionScene:
+			var expedition: ExpeditionScene = curr_scn as ExpeditionScene
+			var room: ExpeditionRoom = expedition.curr_room
+			if room != null and is_instance_valid(room) and room.gold_manager != null and is_instance_valid(room.gold_manager):
+				var gold_manager: ExpeditionGoldManager = room.gold_manager
+				var coin_count: int = mini(gold_manager._positions.size(), mini(gold_manager._states.size(), mini(gold_manager._scales.size(), gold_manager._coin_currencies.size())))
+				var viewport_bounds: = Rect2(Vector2.ZERO, Vector2(BASE_VIEWPORT_SIZE))
+				for index: int in range(coin_count):
+					if gold_manager._states[index] != ExpeditionGoldManager.CoinState.LANDED:
+						continue
+					if gold_manager._coin_currencies[index] != "yellow" or gold_manager._scales[index] <= 0.0:
+						continue
+					var local_position: Vector2 = gold_manager.to_local(gold_manager._positions[index])
+					var logical_position: Vector2 = _builder_policy_canvas_point(gold_manager, local_position)
+					if viewport_bounds.has_point(logical_position):
+						visible_gold_pickups.append({"x": logical_position.x, "y": logical_position.y})
+		match scene_phase:
+			"run_summary":
+				var summary: ExpeditionVictoryPopup = _builder_get_summary_popup()
+				if summary != null:
+					_builder_append_policy_target(visible_action_targets, "summary_return_to_tavern", summary.home_btn, _builder_policy_control_available(summary.home_btn))
+					_builder_append_policy_target(visible_action_targets, "summary_rerun", summary.run_again_btn, _builder_policy_control_available(summary.run_again_btn))
+			"dialogue":
+				var dialogue: DialogueManager = Refs.dialogue as DialogueManager
+				if dialogue != null and is_instance_valid(dialogue):
+					_builder_append_policy_target(visible_action_targets, "dialogue_advance", dialogue.dialogue_panel, dialogue.is_active())
+			"tavern":
+				var popup_manager: PopupManager = Refs.popups as PopupManager
+				if curr_scn is TavernScene and (popup_manager == null or not is_instance_valid(popup_manager) or not popup_manager.has_popup()):
+					var hub: TavernScene = curr_scn as TavernScene
+					if hub.skill_tree != null and is_instance_valid(hub.skill_tree):
+						var stamina_node: SkillNode = hub.skill_tree.nodes_by_id.get("start_stamina") as SkillNode
+						if stamina_node != null and is_instance_valid(stamina_node):
+							_builder_append_policy_target(visible_action_targets, "stamina_skill_node", stamina_node.button, _builder_policy_control_available(stamina_node.button))
+		var observation: = {
+			"scene_phase": scene_phase, 
+			"visible_gold_pickups": visible_gold_pickups, 
+			"visible_action_targets": visible_action_targets, 
+		}
+		JavaScriptBridge.eval("window.__heroPartySetPolicyObservation(" + JSON.stringify(observation) + ");")
+
+
+func _builder_policy_control_available(control: Control) -> bool:
+	if control == null or not is_instance_valid(control) or not control.is_visible_in_tree() or control.mouse_filter == Control.MOUSE_FILTER_IGNORE:
+		return false
+	if control is BaseButton:
+		return not (control as BaseButton).disabled
+	return true
+
+
+func _builder_append_policy_target(targets: Array, target_id: String, control: Control, available: bool) -> void :
+	if control == null or not is_instance_valid(control) or not control.is_visible_in_tree():
+		return
+	var hit_rect: Variant = _builder_policy_hit_rect(control)
+	if hit_rect == null:
+		return
+	var hit_area_available: = available and float(hit_rect.width) >= 1.0 and float(hit_rect.height) >= 1.0
+	targets.append({"id": target_id, "rect": hit_rect, "available": hit_area_available})
+
+
+func _builder_policy_hit_rect(control: Control) -> Variant:
+	if control.size.x <= 0.0 or control.size.y <= 0.0:
+		return null
+	var transform: Transform2D = control.get_global_transform_with_canvas()
+	var corners: Array[Vector2] = [
+		transform * Vector2.ZERO, 
+		transform * Vector2(control.size.x, 0.0), 
+		transform * control.size, 
+		transform * Vector2(0.0, control.size.y), 
+	]
+	var min_point: Vector2 = corners[0]
+	var max_point: Vector2 = corners[0]
+	for corner: Vector2 in corners:
+		min_point.x = minf(min_point.x, corner.x)
+		min_point.y = minf(min_point.y, corner.y)
+		max_point.x = maxf(max_point.x, corner.x)
+		max_point.y = maxf(max_point.y, corner.y)
+	var logical_scale: Vector2 = _builder_policy_logical_scale(control)
+	var rect: = Rect2(min_point * logical_scale, (max_point - min_point) * logical_scale)
+	var bounds: = Rect2(Vector2.ZERO, Vector2(BASE_VIEWPORT_SIZE))
+	if not bounds.intersects(rect):
+		return null
+	var clipped_rect: Rect2 = rect.intersection(bounds)
+	if clipped_rect.size.x <= 0.0 or clipped_rect.size.y <= 0.0:
+		return null
+	return {"x": clipped_rect.position.x, "y": clipped_rect.position.y, "width": clipped_rect.size.x, "height": clipped_rect.size.y}
+
+
+func _builder_policy_canvas_point(item: CanvasItem, local_point: Vector2) -> Vector2:
+	return (item.get_global_transform_with_canvas() * local_point) * _builder_policy_logical_scale(item)
+
+
+func _builder_policy_logical_scale(item: CanvasItem) -> Vector2:
+	var viewport_size: Vector2 = Vector2(item.get_viewport().get_visible_rect().size)
+	if viewport_size.x <= 0.0 or viewport_size.y <= 0.0:
+		return Vector2.ONE
+	return Vector2(BASE_VIEWPORT_SIZE) / viewport_size
 
 

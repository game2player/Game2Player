+			var box = target_boxes[target]
+			if _policy_is_enemy(target) and box.is_visible_in_tree() and viewport_rect.has_point(box.position):
+				contacts[target._gw_id] = _policy_target_record(target)
+	JavaScript.eval("window.__intellispherePolicy.receive(" + JSON.print({
+		"observable_targets": contacts.values(), "missile_warning": _policy_warning
+	}) + ")", true)

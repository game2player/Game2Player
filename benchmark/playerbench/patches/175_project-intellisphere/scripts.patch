+			"id": str(player.target.get_path()), "team": player.target.team, 
+			"health": player.target.health, "damage": player.target.total_damage, 
+			"position": [player.translation.x, player.translation.y, player.translation.z], 
+			"rotation": [player.rotation.x, player.rotation.y, player.rotation.z], 

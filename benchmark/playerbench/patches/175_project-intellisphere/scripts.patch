+			"pitch": player.controller.pitch_knob.value, "roll": player.controller.roll_knob.value, 
+			"yaw": player.controller.yaw_knob.value, "throttle": player.controller.throttle_knob.value, 
+			"brakes": player.controller.brakes_knob.value, "ammo": player.weapons.get_stats(), 
+			"selected_target": str(selected.get_path()) if has_selected else "", 
+			"target_distance": player.radar.distance_to_target(selected) if has_selected else - 1.0, 
+			"target_locked": player.radar.can_lock_onto(selected) if has_selected else false
+		}
+		result.ready = player.controller.use_player_input and player.weapons.loaded_item != null
+	JavaScript.eval("window.__intellisphere.receive(" + JSON.print(result) + ")", true)

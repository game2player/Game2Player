+	var result = {
+		"scene": get_tree().current_scene.filename, "mission_state": state, 
+		"game_time_ms": OS.get_ticks_msec() - initialized_at, 
+		"mission_time_ms": get_mission_time() * 1000.0, 
+		"targets": [], "player": null, "ready": false
+	}
+	for target in Target.get_all(self):
+		result.targets.append(target._gw_record())

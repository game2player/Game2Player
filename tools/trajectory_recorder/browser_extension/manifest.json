{
  "manifest_version": 3,
  "name": "Trajectory Recorder",
  "version": "0.1.0",
  "key": "",
  "description": "Records game tab video for local trajectory collection.",
  "permissions": [
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  }
}
